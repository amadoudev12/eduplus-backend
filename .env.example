# Copie ce fichier en .env puis remplis les valeurs

# Connexion à PostgreSQL
DATABASE_URL="postgresql://postgres:TON_MOT_DE_PASSE@localhost:5432/eduplus"

# Clé secrète qui sert à signer les sessions (une longue chaîne aléatoire)
