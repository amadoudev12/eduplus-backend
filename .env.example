# Port du backend
PORT=4000

# Adresse du frontend autorisée à appeler l'API (en ligne : l'adresse du site sur Vercel)
FRONTEND_URL="http://localhost:3000"

# Compte Cloudinary où sont stockés les fichiers des sujets
